# Copy to backend/.env for local development. Never commit the real .env.

ENV=dev
LOG_LEVEL=INFO

# PostgreSQL from `docker compose up -d postgres` (host port 5433).
DATABASE_URL=postgresql+asyncpg://agentp:agentp@localhost:5433/agentp

# JSON list of allowed browser origins (no wildcards). Add the Vercel production domain in prod.
CORS_ORIGINS=["http://localhost:5173"]
# Optional regex for Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://agent-p-[a-z0-9-]+-yourteam\.vercel\.app

# Operator sign-in. Generate with:  uv run agentp hash-token
# Keep the single quotes: the hash contains '$'.
ADMIN_TOKEN_HASH=
# Long random string; required in prod. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true when served over HTTPS (prod); enables SameSite=None; Secure cookies.
COOKIE_SECURE=false

# LLM providers — server-side only, never exposed to the browser.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=

# Docker engine for sandbox containers (used from M4). On macOS + Colima:
# DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock
# Find it with: docker context inspect colima --format '{{.Endpoints.docker.Host}}'
